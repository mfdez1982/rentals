<!DOCTYPE html>
<html data-theme="emerald">
  <head>
    <title><%= content_for(:title) || "Rentals" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rentals">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<link href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.css">
    <style>
      .icon-btn svg { width: 20px !important; height: 20px !important; }
      /* The cookie consent banner ships with a max z-index so it always sits above page
         content, but that also puts it above its own preferences modal/overlay when the
         two are open at once. Pin the banner below the preferences modal explicitly. */
      .cm-wrapper { z-index: 40 !important; }
      .pm-wrapper { z-index: 50 !important; }
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 min-h-screen">
    <%= render "shared/nav" %>
    <main class="max-w-5xl mx-auto px-4 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
