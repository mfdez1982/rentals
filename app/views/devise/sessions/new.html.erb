<div class="flex justify-center items-center min-h-screen bg-base-200">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl font-bold mb-6">Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-control mb-4">
          <%= f.label :email, class: "label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password, class: "label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-control mb-6">
            <label class="label cursor-pointer justify-start gap-3">
              <%= f.check_box :remember_me %>
              <span class="label-text"><%= f.label :remember_me, t("remember_me", default: "Remember me") %></span>
            </label>
          </div>
        <% end %>

        <div class="form-control">
          <%= f.submit t("login", default: "Log in"), class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="divider mt-6 mb-4"></div>

      <div class="flex flex-col gap-2 text-sm text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
