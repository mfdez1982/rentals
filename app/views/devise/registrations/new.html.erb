<div class="flex justify-center items-center min-h-screen">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl font-bold mb-6"><%= t("devise.registrations.sign_up") %></h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <% if @invitation_token.present? %>
          <%= hidden_field_tag "#{resource_name}[invitation_token]", @invitation_token %>
        <% end %>

        <div class="form-control mb-4">
          <%= f.label :email, class: "label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password, class: "label" %>
          <% if @minimum_password_length %>
            <span class="label-text text-xs text-base-content/70">(<%= t("devise.registrations.characters_minimum", count: @minimum_password_length) %>)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-6">
          <%= f.label :password_confirmation, class: "label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.submit t("devise.registrations.sign_up"), class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="divider mt-6 mb-4"></div>

      <div class="flex flex-col gap-2 text-sm text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
