<div class="mb-6">
  <%= link_to t("common.my_properties_link"), properties_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6">
  <h1 class="text-2xl font-bold"><%= @property.name %> — <%= t("tax_report.title") %></h1>
</div>

<%= turbo_frame_tag dom_id(@property, :tax_report) do %>
  <div data-controller="modal">
  <!-- Generate control -->
  <div class="mb-8 flex items-baseline gap-3" data-controller="year-select" data-year-select-base-url-value="<%= property_tax_reports_path(@property) %>">
    <%= form_with url: property_tax_reports_path(@property), method: :post, class: "flex items-baseline gap-3" do %>
      <label for="tax_report_year" class="text-sm font-semibold text-base-content/70"><%= t("tax_report.select_year") %></label>
      <select id="tax_report_year" name="year" class="select select-bordered select-sm w-32" data-year-select-target="year" data-action="change->year-select#reload">
        <% @year_options.each do |year| %>
          <option value="<%= year %>" <%= "selected" if year == @year %>><%= year %></option>
        <% end %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm"><%= t("tax_report.generate") %></button>
    <% end %>
  </div>

  <% if @collectable_deductible_expenses.present? %>
    <div class="mb-6">
      <div class="alert alert-warning mb-4" role="status">
        <span class="text-sm"><%= t("tax_report.validate_expenses_warning") %></span>
      </div>
      <div class="overflow-x-auto mb-2">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th><%= t("tax_report.table_headers.date") %></th>
              <th><%= t("tax_report.table_headers.category") %></th>
              <th><%= t("tax_report.table_headers.description") %></th>
              <th class="text-right"><%= t("tax_report.table_headers.original_amount") %></th>
            </tr>
          </thead>
          <tbody>
            <% @collectable_deductible_expenses.each do |expense| %>
              <tr>
                <td><%= l(expense.date, format: :short) %></td>
                <td><span class="badge badge-sm"><%= t("expenses.categories.#{expense.category}") %></span></td>
                <td><%= expense.description || "—" %></td>
                <td class="text-right"><%= number_to_currency(expense.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-base-content/50"><%= t("tax_report.validate_expenses_hint") %></p>
    </div>
  <% end %>

  <!-- Saved reports -->
  <h3 class="font-semibold text-base-content/70 mb-2"><%= t("tax_report.saved_reports") %></h3>

  <% if @tax_reports.any? %>
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th><%= t("tax_report.table_headers.name") %></th>
            <th><%= t("tax_report.table_headers.year") %></th>
            <th><%= t("tax_report.table_headers.generated_at") %></th>
            <th class="text-right"><%= t("tax_report.table_headers.gross_income") %></th>
            <th class="text-right"><%= t("tax_report.table_headers.active_days") %></th>
            <th class="text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @tax_reports.each do |report| %>
            <tr>
              <td><%= report.name.presence || "—" %></td>
              <td class="font-semibold"><%= report.year %></td>
              <td><%= l(report.created_at, format: :short) %></td>
              <td class="text-right"><%= number_to_currency(report.total_gross_income) %></td>
              <td class="text-right"><%= report.active_rental_days %></td>
              <td class="text-right">
                <div class="flex justify-end items-center gap-2">
                  <%= link_to t("common.open"), property_tax_report_path(@property, report), class: "btn btn-primary btn-xs", data: { turbo_frame: "_top" } %>
                  <%= link_to edit_property_tax_report_path(@property, report),
                      class: "icon-btn",
                      title: t("tax_report.edit_name"),
                      data: { turbo_frame: "tax_report_edit_frame", action: "click->modal#openFrame" } do %>
                    <%= heroicon "pencil", variant: :outline %>
                  <% end %>
                  <%= button_to property_tax_report_path(@property, report), method: :delete,
                      class: "icon-btn",
                      title: t("forms.buttons.delete"),
                      form: { data: { turbo_confirm: t("tax_report.confirm_delete") } } do %>
                    <%= heroicon "trash", variant: :outline %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-base-content/50">
      <p class="text-sm"><%= t("tax_report.no_saved_reports") %></p>
    </div>
  <% end %>

  <!-- Tax Report Edit Name Modal -->
  <%= render layout: "shared/modal", locals: { box_class: "max-w-md" } do %>
    <%= turbo_frame_tag "tax_report_edit_frame" do %>
      <% if @editing_tax_report %>
        <%= render "edit_modal_content", property: @property, tax_report: @editing_tax_report %>
      <% end %>
    <% end %>
  <% end %>
  </div>
<% end %>
