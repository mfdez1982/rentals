<div class="mb-6">
  <%= link_to t("tax_report.back_to_reports"), property_tax_reports_path(@property), class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6 flex items-baseline justify-between gap-3 flex-wrap">
  <h1 class="text-2xl font-bold"><%= @property.name %> — <%= t("tax_report.title") %> <%= @tax_report.year %></h1>
  <span class="text-xs text-base-content/50"><%= t("tax_report.generated_on", date: l(@tax_report.created_at, format: :short)) %></span>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.active_rental_days") %></div>
      <div class="text-3xl font-bold"><%= @tax_report.active_rental_days %></div>
      <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.active_rental_days_hint", total: @tax_report.total_days, year: @tax_report.year) %></div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.pro_rata_ratio") %></div>
      <div class="text-3xl font-bold"><%= number_to_percentage(@tax_report.pro_rata_ratio * 100, precision: 2) %></div>
      <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.pro_rata_ratio_hint") %></div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.total_gross_income") %></div>
      <div class="text-3xl font-bold"><%= number_to_currency(@tax_report.total_gross_income) %></div>
      <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.total_gross_income_hint", year: @tax_report.year) %></div>
    </div>
  </div>
</div>

<!-- Expenses Table -->
<h3 class="font-semibold text-base-content/70 mb-2"><%= t("tax_report.deductible_expenses") %></h3>

<% if @tax_report.expense_lines.any? %>
  <div class="overflow-x-auto">
    <table class="table table-zebra table-sm">
      <thead>
        <tr>
          <th><%= t("tax_report.table_headers.date") %></th>
          <th><%= t("tax_report.table_headers.category") %></th>
          <th><%= t("tax_report.table_headers.description") %></th>
          <th class="text-right"><%= t("tax_report.table_headers.original_amount") %></th>
          <th class="text-right"><%= t("tax_report.table_headers.deductible_amount") %></th>
        </tr>
      </thead>
      <tbody>
        <% @tax_report.expense_lines.each do |line| %>
          <tr>
            <td><%= l(Date.parse(line["date"]), format: :short) %></td>
            <td><span class="badge badge-sm"><%= t("expenses.categories.#{line["category"]}") %></span></td>
            <td><%= line["description"] || "—" %></td>
            <td class="text-right"><%= number_to_currency(line["original_amount"]) %></td>
            <td class="text-right font-semibold text-success"><%= number_to_currency(line["deductible_amount"]) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-semibold bg-base-200">
          <td colspan="3"><%= t("tax_report.total_row") %></td>
          <td class="text-right"><%= number_to_currency(@tax_report.total_original_amount) %></td>
          <td class="text-right text-success"><%= number_to_currency(@tax_report.total_deductible_amount) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <div class="text-center py-8 text-base-content/50">
    <p class="text-sm"><%= t("tax_report.no_expenses", year: @tax_report.year) %></p>
  </div>
<% end %>

<div class="mt-6">
  <div class="alert bg-base-200 border-base-300 text-base-content/70">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="shrink-0 w-6 h-6 stroke-base-content/50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span class="text-sm">
      <%= t("tax_report.pro_rata_explanation", ratio: number_to_percentage(@tax_report.pro_rata_ratio * 100, precision: 2)) %>
    </span>
  </div>
</div>
