<!-- Navigation Tabs -->
<% properties_active = request.path_info.start_with?("/properties") %>
<% notes_active = request.path_info.start_with?("/notes") %>

<nav class="flex gap-8 border-b border-base-300 mb-6">
  <%= link_to t("properties.my_properties"), properties_path,
      class: "tab-link#{' tab-link-active' if properties_active}" %>

  <%= link_to t("notes.my_notes"), notes_path,
      class: "tab-link#{' tab-link-active' if notes_active}" %>
</nav>

<!-- Main Content -->
<div>
  <%= yield %>
</div>
