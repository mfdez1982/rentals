<%= form_with model: [property, expense], data: local_assigns.fetch(:form_data, { turbo_frame: dom_id(property, :expenses) }) do |f| %>
  <div class="space-y-4 max-w-md" data-controller="toggle">
    <%= render "shared/form_errors", model: expense %>

    <div>
      <%= f.label :date, t("expenses.date"), class: "label mb-1" %>
      <%= f.date_field :date, class: "input input-bordered w-full", required: true %>
    </div>

    <div>
      <%= f.label :category, t("expenses.category"), class: "label mb-1" %>
      <%= f.select :category,
            Expense.categories.keys.map { |k| [t("expenses.categories.#{k}"), k] },
            { include_blank: t("expenses.select_category") },
            class: "select select-bordered w-full", required: true %>
    </div>

    <div>
      <%= f.label :amount, t("expenses.amount"), class: "label mb-1" %>
      <%= f.number_field :amount, class: "input input-bordered w-full",
            step: "0.01", min: "0.01", placeholder: t("expenses.amount_placeholder"), required: true %>
    </div>

    <div>
      <%= f.label :description, class: "label mb-1" do %>
        <%= t("expenses.description") %> <span class="text-base-content/60"><%= t("expenses.description_hint") %></span>
      <% end %>
      <%= f.text_field :description, class: "input input-bordered w-full",
            placeholder: t("expenses.description_placeholder") %>
    </div>

    <% if current_landlord.expense_document_allowed? %>
      <div>
        <%= f.label :invoice_document, class: "label mb-1" do %>
          <%= t("expenses.invoice_document.label") %> <span class="text-base-content/60"><%= t("expenses.invoice_document.pdf_hint") %></span>
        <% end %>
        <% if expense.invoice_document.attached? %>
          <p class="text-sm mb-2 flex items-center gap-2">
            <%= link_to expense.invoice_document.filename.to_s,
                document_property_expense_path(property, expense),
                class: "link", data: { turbo_frame: "_top" } %>
          </p>
          <label class="label cursor-pointer justify-start gap-2 mb-1">
            <%= check_box_tag "expense[remove_invoice_document]", "1", false, class: "checkbox checkbox-sm" %>
            <span class="label-text"><%= t("expenses.invoice_document.remove") %></span>
          </label>
        <% end %>
        <%= f.file_field :invoice_document, accept: "application/pdf",
              class: "file-input file-input-bordered w-full" %>
      </div>
    <% end %>

    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-2">
        <%= f.check_box :collectable, class: "checkbox", data: { toggle_target: "checkbox", action: "toggle#update" } %>
        <span class="label-text"><%= t("expenses.collectable") %></span>
      </label>
      <span class="text-base-content/60 text-sm"><%= t("expenses.collectable_hint") %></span>
    </div>

    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-2">
        <%= f.check_box :deductible, class: "checkbox" %>
        <span class="label-text"><%= t("expenses.deductible") %></span>
      </label>
      <span class="text-base-content/60 text-sm"><%= t("expenses.deductible_hint") %></span>
    </div>

    <div data-toggle-target="wrapper" class="<%= "hidden" unless expense.collectable? %>">
      <%= f.label :period_start, t("expenses.period_start"), class: "label mb-1" %>
      <%= f.date_field :period_start, class: "input input-bordered w-full" %>
    </div>

    <div data-toggle-target="wrapper" class="<%= "hidden" unless expense.collectable? %>">
      <%= f.label :period_end, t("expenses.period_end"), class: "label mb-1" %>
      <%= f.date_field :period_end, class: "input input-bordered w-full" %>
    </div>

    <%= render "shared/form_actions", form: f %>
  </div>
<% end %>
