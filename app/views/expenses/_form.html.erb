<%= form_with model: [property, expense], data: local_assigns.fetch(:form_data, { turbo_frame: "_top" }) do |f| %>
  <div class="space-y-4 max-w-md">
    <% if expense.errors.any? %>
      <div role="alert" class="alert alert-error">
        <ul class="list-disc list-inside text-sm">
          <% expense.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :date, t("expenses.date"), class: "label mb-1" %>
      <%= f.date_field :date, class: "input input-bordered w-full" %>
    </div>

    <div>
      <%= f.label :category, t("expenses.category"), class: "label mb-1" %>
      <%= f.select :category,
            Expense.categories.keys.map { |k| [t("expenses.categories.#{k}"), k] },
            { include_blank: t("expenses.select_category") },
            class: "select select-bordered w-full" %>
    </div>

    <div>
      <%= f.label :amount, t("expenses.amount"), class: "label mb-1" %>
      <%= f.number_field :amount, class: "input input-bordered w-full",
            step: "0.01", min: "0.01", placeholder: t("expenses.amount_placeholder") %>
    </div>

    <div>
      <%= f.label :description, class: "label mb-1" do %>
        <%= t("expenses.description") %> <span class="text-base-content/60"><%= t("expenses.description_hint") %></span>
      <% end %>
      <%= f.text_field :description, class: "input input-bordered w-full",
            placeholder: t("expenses.description_placeholder") %>
    </div>

    <div>
      <%= f.label :invoice_url, class: "label mb-1" do %>
        <%= t("expenses.invoice_url") %> <span class="text-base-content/60"><%= t("expenses.invoice_url_hint") %></span>
      <% end %>
      <%= f.url_field :invoice_url, class: "input input-bordered w-full",
            placeholder: t("expenses.invoice_url_placeholder") %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit expense.persisted? ? t("expenses.form.submit_update") : t("expenses.form.submit_create"), class: "btn btn-primary" %>
      <button type="button" class="btn btn-ghost" data-action="modal#close"><%= t("forms.buttons.cancel") %></button>
    </div>
  </div>
<% end %>
