<tr>
  <td><%= expense.date.strftime("%b %d, %Y") %></td>
  <td><%= expense.category.humanize %></td>
  <td><%= expense.description %></td>
  <td><%= number_to_currency(expense.amount) %></td>
  <td class="text-right">
    <div style="display:inline-flex; align-items:center; gap:8px;">
      <%= link_to edit_property_expense_path(property, expense),
          class: "icon-btn",
          title: "Edit",
          style: "display:inline-flex; color:inherit; cursor:pointer;",
          data: { action: "click->expenses#openEdit" } do %>
        <%= heroicon "pencil", variant: :outline %>
      <% end %>
      <%= button_to property_expense_path(property, expense),
          method: :delete,
          class: "icon-btn",
          title: "Delete",
          style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;",
          form: { data: {
            turbo_confirm: "Delete this expense? This cannot be undone.",
            turbo_frame: dom_id(property, :expenses)
          } } do %>
        <%= heroicon "trash", variant: :outline %>
      <% end %>
      <% if expense.invoice_url.present? %>
        <a href="<%= expense.invoice_url %>" class="icon-btn" title="View invoice"
           style="display:inline-flex; color:inherit; cursor:pointer;"
           target="_blank" rel="noopener">
          <%= heroicon "document-text", variant: :outline %>
        </a>
      <% end %>
    </div>
  </td>
</tr>
