<tr>
  <td><%= format_date(expense.date) %></td>
  <td><%= t("expenses.categories.#{expense.category}") %></td>
  <td><%= expense.description %></td>
  <td><%= number_to_currency(expense.amount) %></td>
  <td>
    <% if expense.collectable? %>
      <span class="badge badge-info badge-sm"><%= t("expenses.collectable_badge") %></span>
    <% end %>
    <% unless expense.deductible? %>
      <span class="badge badge-ghost badge-sm"><%= t("expenses.non_deductible_badge") %></span>
    <% end %>
  </td>
  <td class="text-right">
    <div class="inline-flex items-center gap-2">
      <% unless property_read_only?(property) %>
        <% if expense.collectable? %>
          <%= link_to t("recollections.recollect"),
              new_property_expense_recollection_path(property, expense),
              class: "btn btn-primary btn-xs",
              data: { turbo_frame: "_top" } %>
        <% end %>
        <%= render "shared/edit_icon_button", path: edit_property_expense_path(property, expense), frame: "expense_edit_frame" %>
        <%= render "shared/delete_icon_button", path: property_expense_path(property, expense), confirm: t("expenses.delete_confirm"), frame: dom_id(property, :expenses) %>
      <% end %>
      <% if expense.invoice_document.attached? %>
        <%= link_to document_property_expense_path(property, expense), class: "icon-btn",
            title: t("expenses.invoice_document.view"), data: { turbo_frame: "_top" } do %>
          <%= heroicon "paper-clip", variant: :outline %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
