<tr>
  <td><%= format_date(expense.date) %></td>
  <td><%= t("expenses.categories.#{expense.category}") %></td>
  <td><%= expense.description %></td>
  <td><%= number_to_currency(expense.amount) %></td>
  <td>
    <% if expense.collectable? %>
      <span class="badge badge-info badge-sm"><%= t("expenses.collectable_badge") %></span>
    <% end %>
  </td>
  <td class="text-right">
    <div class="inline-flex items-center gap-2">
      <% if expense.collectable? %>
        <%= link_to t("recollections.recollect"),
            new_property_expense_recollection_path(property, expense),
            class: "btn btn-primary btn-xs",
            data: { turbo_frame: "_top" } %>
      <% end %>
      <%= link_to edit_property_expense_path(property, expense),
          class: "icon-btn",
          title: t("forms.buttons.edit"),
          data: { turbo_frame: "expense_edit_frame", action: "click->modal#openFrame" } do %>
        <%= heroicon "pencil", variant: :outline %>
      <% end %>
      <%= button_to property_expense_path(property, expense),
          method: :delete,
          class: "icon-btn",
          title: t("forms.buttons.delete"),
          form: { data: {
            turbo_confirm: t("expenses.delete_confirm"),
            turbo_frame: dom_id(property, :expenses)
          } } do %>
        <%= heroicon "trash", variant: :outline %>
      <% end %>
      <% if expense.invoice_url.present? %>
        <a href="<%= expense.invoice_url %>" class="icon-btn" title="<%= t('expenses.view_invoice') %>"
           target="_blank" rel="noopener">
          <%= heroicon "document-text", variant: :outline %>
        </a>
      <% end %>
    </div>
  </td>
</tr>
