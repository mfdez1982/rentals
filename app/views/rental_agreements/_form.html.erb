<%= form_with model: [property, agreement], data: local_assigns.fetch(:form_data, { turbo_frame: dom_id(property, :agreements) }) do |f| %>
  <div class="space-y-4 max-w-md">
    <% if local_assigns[:inline] %>
      <input type="hidden" name="inline" value="true">
    <% end %>

    <% if agreement.errors.any? %>
      <div role="alert" class="alert alert-error">
        <ul class="list-disc list-inside text-sm">
          <% agreement.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :start_date, t("rental_agreements.start_date"), class: "label mb-1" %>
      <%= f.date_field :start_date, class: "input input-bordered w-full" %>
    </div>

    <div>
      <%= f.label :end_date, t("rental_agreements.end_date"), class: "label mb-1" %>
      <%= f.date_field :end_date, class: "input input-bordered w-full" %>
    </div>

    <div>
      <%= f.label :rent_amount, t("rental_agreements.monthly_rent"), class: "label mb-1" %>
      <%= f.number_field :rent_amount, class: "input input-bordered w-full",
            step: "0.01", min: "0.01", placeholder: t("rental_agreements.rent_amount_placeholder") %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit t("forms.buttons.submit"), class: "btn btn-primary" %>
      <% if local_assigns[:cancel_action] %>
        <button type="button" class="btn btn-ghost" data-action="<%= cancel_action %>"><%= t("forms.buttons.cancel") %></button>
      <% else %>
        <%= link_to t("forms.buttons.cancel"), property_path(property), class: "btn btn-ghost" %>
      <% end %>
    </div>
  </div>
<% end %>
