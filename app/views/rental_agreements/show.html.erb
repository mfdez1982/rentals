<div class="mb-6">
  <%= link_to "← #{@property.name}", property_path(@property), class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6">
  <div class="flex items-center gap-3">
    <%= turbo_frame_tag dom_id(@agreement, :dates) do %>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold">
          <%= format_date(@agreement.start_date) %> – <%= format_date(@agreement.end_date) %>
        </h1>
        <%= link_to edit_property_rental_agreement_path(@property, @agreement, inline: "dates"),
              data: { turbo_frame: dom_id(@agreement, :dates) },
              class: "btn btn-ghost btn-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 9.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-3 mt-2">
    <%= turbo_frame_tag dom_id(@agreement, :rent) do %>
      <div class="flex items-center gap-2">
        <span class="text-base-content/70"><%= number_to_currency(@agreement.rent_amount) %>/mo</span>
        <%= link_to edit_property_rental_agreement_path(@property, @agreement, inline: "rent"),
              data: { turbo_frame: dom_id(@agreement, :rent) },
              class: "btn btn-ghost btn-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 9.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        <% end %>
      </div>
    <% end %>
    <span class="badge badge-sm <%= @agreement.status_badge_class %>"><%= @agreement.status %></span>
  </div>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="payments">
  <div class="card-body">
    <h2 class="card-title text-base mb-4">Payments</h2>

    <%= turbo_frame_tag dom_id(@agreement, :payments) do %>
      <% overdue = @payments.select(&:overdue?) %>
      <% if overdue.any? %>
        <div class="badge badge-error gap-1 mb-4">
          <%= overdue.size %> overdue payment<%= overdue.size == 1 ? "" : "s" %>
        </div>
      <% end %>

      <% if @payments.any? %>
        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Due Date</th>
                <th>Paid Date</th>
                <th>Amount</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @payments.each do |payment| %>
                <%= turbo_frame_tag dom_id(payment),
                      data: { row_url: property_rental_agreement_path(@property, @agreement) } do %>
                  <%= render "payments/payment", property: @property, agreement: @agreement, payment: payment %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50 mb-6">
          <p class="text-sm">No payments recorded yet. Add one below.</p>
        </div>
      <% end %>

      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-base">Add Payments</h3>
          <%= render "payments/create_recurring_form", property: @property, agreement: @agreement %>
        </div>
      </div>
    <% end %>
  </div>
</div>
