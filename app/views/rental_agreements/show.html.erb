<div class="mb-6">
  <%= link_to "← #{@property.name}", property_path(@property), class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6">
  <h1 class="text-2xl font-bold">
    <%= @agreement.start_date.strftime("%b %d, %Y") %> – <%= @agreement.end_date.strftime("%b %d, %Y") %>
  </h1>
  <div class="flex flex-wrap items-center gap-3 mt-2">
    <span class="text-base-content/70"><%= number_to_currency(@agreement.rent_amount) %>/mo</span>
    <span class="badge badge-sm <%= @agreement.status_badge_class %>"><%= @agreement.status %></span>
  </div>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="payments">
  <div class="card-body">
    <h2 class="card-title text-base mb-4">Payments</h2>

    <%= turbo_frame_tag dom_id(@agreement, :payments) do %>
      <% overdue = @payments.select(&:overdue?) %>
      <% if overdue.any? %>
        <div class="badge badge-error gap-1 mb-4">
          <%= overdue.size %> overdue payment<%= overdue.size == 1 ? "" : "s" %>
        </div>
      <% end %>

      <% if @payments.any? %>
        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Due Date</th>
                <th>Paid Date</th>
                <th>Amount</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @payments.each do |payment| %>
                <%= turbo_frame_tag dom_id(payment),
                      data: { row_url: property_rental_agreement_path(@property, @agreement) } do %>
                  <%= render "payments/payment", property: @property, agreement: @agreement, payment: payment %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50 mb-6">
          <p class="text-sm">No payments recorded yet. Add one below.</p>
        </div>
      <% end %>

      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-base">Add Payments</h3>
          <%= render "payments/create_recurring_form", property: @property, agreement: @agreement %>
        </div>
      </div>
    <% end %>
  </div>
</div>
