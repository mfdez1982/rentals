<div class="mb-6">
  <%= link_to "← #{@property.name}", property_path(@property), class: "btn btn-ghost btn-sm" %>
</div>

<%= turbo_frame_tag dom_id(@agreement, :header) do %>
  <div class="mb-6" data-controller="modal">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold">
        <%= format_date(@agreement.start_date) %> – <%= format_date(@agreement.end_date) %>
      </h1>
    </div>
    <div class="flex flex-wrap items-center gap-3 mt-2">
      <span class="text-base-content/70"><%= number_to_currency(@agreement.rent_amount) %><%= t('rental_agreements.monthly_suffix') %></span>
      <%= link_to edit_property_rental_agreement_path(@property, @agreement, inline: true),
          class: "icon-btn",
          title: t("forms.buttons.edit"),
          "aria-label": t("forms.buttons.edit"),
          data: { turbo_frame: "agreement_edit_frame", action: "click->modal#openFrame" } do %>
        <%= heroicon "pencil", variant: :outline %>
      <% end %>
      <span class="badge badge-sm <%= agreement_status_badge_class(@agreement) %>"><%= agreement_status(@agreement) %></span>
    </div>

    <%= render layout: "shared/modal", locals: { box_class: "max-w-lg" } do %>
      <%= turbo_frame_tag "agreement_edit_frame" do %>
        <% if @editing_agreement %>
          <%= render "edit_modal_content", property: @property, agreement: @editing_agreement %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<!-- Navigation Tabs & Content (Tab-Managed) -->
<div data-controller="tabs" data-tabs-active-tab-value="payments">
  <nav class="flex gap-8 border-b border-base-300 mb-6">
    <%= link_to t("payments.payments"), "#",
        data: { tabs_tab: "payments", action: "click->tabs#selectTab" } %>

    <%= link_to t("notes.my_notes"), "#",
        data: { tabs_tab: "notas", action: "click->tabs#selectTab" } %>

    <%= link_to t("agreement_tenants.tab_label"), "#",
        data: { tabs_tab: "tenants", action: "click->tabs#selectTab" } %>

    <%= link_to t("rental_agreements.lease_document.tab_label"), "#",
        data: { tabs_tab: "lease", action: "click->tabs#selectTab" } %>
  </nav>

  <!-- Payments Section -->
  <div data-tab-section="payments">
    <div class="card bg-base-100 shadow-sm" data-controller="modal">
      <div class="card-body">
        <!-- Toolbar -->
        <div class="flex items-center justify-between mb-6">
          <h2 class="card-title text-base"><%= t("payments.payments") %></h2>
          <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
            <%= t("payments.add_payments") %>
          </button>
        </div>

        <%= turbo_frame_tag dom_id(@agreement, :payments) do %>
          <div data-controller="modal">
            <% overdue = @payments.select(&:overdue?) %>
            <% if overdue.any? %>
              <div class="badge badge-error gap-1 mb-4">
                <%= t("payments.overdue_badge", count: overdue.size) %>
              </div>
            <% end %>

            <% if @payments.any? %>
              <div class="overflow-x-auto">
                <table class="table table-zebra">
                  <thead>
                    <tr>
                      <th><%= t("payments.table_headers.due_date") %></th>
                      <th><%= t("payments.table_headers.paid_date") %></th>
                      <th><%= t("payments.table_headers.amount") %></th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @payments.each do |payment| %>
                      <%= render "payments/payment", property: @property, agreement: @agreement, payment: payment %>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center py-8 text-base-content/50">
                <p class="text-sm"><%= t("payments.no_payments") %></p>
              </div>
            <% end %>

            <!-- Payment Edit Modal -->
            <%= render layout: "shared/modal", locals: { box_class: "max-w-lg" } do %>
              <%= turbo_frame_tag "payment_edit_frame" do %>
                <% if @editing_payment %>
                  <%= render "payments/edit_modal_content", property: @property, agreement: @agreement, payment: @editing_payment %>
                <% end %>
              <% end %>
            <% end %>
          </div>

          <!-- Payments Modal -->
          <%= render layout: "shared/modal", locals: { title: t("payments.add_payments"), box_class: "max-w-lg" } do %>
            <%= render "payments/create_recurring_form", property: @property, agreement: @agreement %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Notes Section -->
  <div data-tab-section="notas">
    <div class="card bg-base-100 shadow-sm" data-controller="modal">
      <div class="card-body">
        <!-- Toolbar -->
        <div class="flex items-center justify-between mb-6">
          <h2 class="card-title text-base"><%= t("notes.my_notes") %></h2>
          <button type="button" class="btn btn-primary btn-sm" data-action="modal#open" <%= "disabled" unless current_landlord.notes_allowed? %>>
            <%= t("notes.add_note") %>
          </button>
        </div>

        <% unless current_landlord.notes_allowed? %>
          <div class="alert alert-info mb-6" role="alert">
            <%= heroicon "sparkles", variant: :outline, class: "w-6 h-6" %>
            <span class="text-base font-medium"><%= t("notes.plan_limit_hint") %></span>
          </div>
        <% end %>

        <%= turbo_frame_tag dom_id(@agreement, :notes) do %>
          <div class="overflow-x-auto">
            <%= render "notes/notes_list", notes: @notes, note_frame_id: dom_id(@agreement, :notes) %>
          </div>

          <!-- Notes Modal -->
          <%= render layout: "shared/modal", locals: { title: t("notes.add_note"), box_class: "max-w-lg" } do %>
            <%= render "notes/form", note: Note.new(landlord: current_landlord), noteable: @agreement, frame: dom_id(@agreement, :notes) %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tenants Section -->
  <div data-tab-section="tenants">
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-base mb-4"><%= t("agreement_tenants.tab_label") %></h2>

        <%= turbo_frame_tag dom_id(@agreement, :tenants) do %>
          <% if @agreement_tenants.any? %>
            <div class="overflow-x-auto mb-6">
              <table class="table table-zebra">
                <thead>
                  <tr>
                    <th><%= t("agreement_tenants.table_headers.email") %></th>
                    <th><%= t("agreement_tenants.table_headers.status") %></th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @agreement_tenants.each do |agreement_tenant| %>
                    <tr>
                      <td><%= agreement_tenant.invited_email %></td>
                      <td>
                        <span class="badge badge-sm <%= agreement_tenant_status_badge_class(agreement_tenant) %>">
                          <%= t("agreement_tenants.status.#{agreement_tenant.status}") %>
                        </span>
                      </td>
                      <td>
                        <div class="flex items-center gap-2">
                          <% if agreement_tenant.pending? %>
                            <%= button_to t("agreement_tenants.kill_invite"),
                                property_rental_agreement_agreement_tenant_path(@property, @agreement, agreement_tenant),
                                method: :delete,
                                class: "btn btn-ghost btn-xs",
                                form: { data: { turbo_confirm: t("agreement_tenants.kill_invite_confirm") } } %>
                          <% elsif agreement_tenant.accepted? %>
                            <%= button_to t("agreement_tenants.remove"),
                                property_rental_agreement_agreement_tenant_path(@property, @agreement, agreement_tenant),
                                method: :delete,
                                class: "btn btn-error btn-xs",
                                form: { data: { turbo_confirm: t("agreement_tenants.remove_confirm") } } %>
                          <% elsif agreement_tenant.rejected? %>
                            <%= button_to t("agreement_tenants.retry"),
                                retry_property_rental_agreement_agreement_tenant_path(@property, @agreement, agreement_tenant),
                                method: :post,
                                class: "btn btn-primary btn-xs" %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-8 text-base-content/50">
              <p class="text-sm"><%= t("agreement_tenants.no_tenants") %></p>
            </div>
          <% end %>

          <%= form_with url: property_rental_agreement_agreement_tenants_path(@property, @agreement), method: :post, scope: :agreement_tenant, class: "max-w-md" do |f| %>
            <div class="form-control mb-3">
              <label for="agreement_tenant_invited_email" class="label"><%= t("agreement_tenants.form.email_label") %></label>
              <%= f.email_field :invited_email, id: "agreement_tenant_invited_email",
                  class: "input input-bordered w-full", placeholder: t("agreement_tenants.form.email_placeholder") %>
            </div>
            <div>
              <%= f.submit t("agreement_tenants.form.submit"), class: "btn btn-primary" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Lease Document Section -->
  <div data-tab-section="lease">
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <% allowed = current_landlord.lease_document_allowed? %>
        <h2 class="card-title text-base mb-4"><%= t("rental_agreements.lease_document.section_title") %></h2>

        <% unless allowed %>
          <div class="alert alert-info mb-6" role="alert">
            <%= heroicon "sparkles", variant: :outline, class: "w-6 h-6" %>
            <span class="text-base font-medium"><%= t("rental_agreements.lease_document.plan_limit_hint") %></span>
          </div>
        <% end %>

        <%= turbo_frame_tag dom_id(@agreement, :lease_document) do %>
          <% if @agreement.errors[:lease_document].any? %>
            <div class="alert alert-error mb-6" role="alert">
              <span><%= @agreement.errors[:lease_document].to_sentence %></span>
            </div>
          <% end %>

          <% if @agreement.lease_document.attached? %>
            <div class="flex items-center gap-3">
              <%= heroicon "document-text", variant: :outline, class: "w-6 h-6 text-base-content/70" %>
              <%= link_to @agreement.lease_document.filename.to_s,
                  property_rental_agreement_lease_document_path(@property, @agreement),
                  class: "link", data: { turbo_frame: "_top" } %>
              <% if allowed %>
                <%= button_to property_rental_agreement_lease_document_path(@property, @agreement),
                    method: :delete, class: "icon-btn",
                    title: t("forms.buttons.delete"),
                    form: { data: { turbo_confirm: t("rental_agreements.lease_document.delete_confirm"),
                                    turbo_frame: dom_id(@agreement, :lease_document) } } do %>
                  <%= heroicon "trash", variant: :outline %>
                <% end %>
              <% end %>
            </div>
          <% elsif allowed %>
            <p class="text-sm text-base-content/50 mb-6"><%= t("rental_agreements.lease_document.none_yet") %></p>
            <%= form_with url: property_rental_agreement_lease_document_path(@property, @agreement),
                method: :post, scope: :rental_agreement, class: "max-w-md" do |f| %>
              <div class="form-control mb-3">
                <label for="rental_agreement_lease_document" class="label mb-1">
                  <%= t("rental_agreements.lease_document.upload_label") %>
                  <span class="text-base-content/60"><%= t("rental_agreements.lease_document.pdf_hint") %></span>
                </label>
                <%= f.file_field :lease_document, id: "rental_agreement_lease_document",
                    accept: "application/pdf", class: "file-input file-input-bordered w-full" %>
              </div>
              <div>
                <%= f.submit t("rental_agreements.lease_document.submit"), class: "btn btn-primary" %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
