<div class="mb-6">
  <%= link_to "← #{@property.name}", property_path(@property), class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6">
  <div class="flex items-center gap-3">
    <%= turbo_frame_tag dom_id(@agreement, :dates) do %>
      <div class="flex items-center gap-2"
           data-controller="rental-agreements"
           data-action="dblclick->rental-agreements#editDates"
           data-rental-agreements-edit-url="<%= edit_property_rental_agreement_path(@property, @agreement, inline: "dates") %>"
           data-rental-agreements-frame-id="<%= dom_id(@agreement, :dates) %>">
        <h1 class="text-2xl font-bold cursor-pointer hover:opacity-75 transition-opacity" title="<%= t('rental_agreements.edit_inline') %>">
          <%= format_date(@agreement.start_date) %> – <%= format_date(@agreement.end_date) %>
        </h1>
      </div>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-3 mt-2">
    <%= turbo_frame_tag dom_id(@agreement, :rent) do %>
      <div class="flex items-center gap-2"
           data-controller="rental-agreements"
           data-action="dblclick->rental-agreements#editRent"
           data-rental-agreements-edit-url="<%= edit_property_rental_agreement_path(@property, @agreement, inline: "rent") %>"
           data-rental-agreements-frame-id="<%= dom_id(@agreement, :rent) %>">
        <span class="text-base-content/70 cursor-pointer hover:opacity-75 transition-opacity" title="<%= t('rental_agreements.edit_inline') %>"><%= number_to_currency(@agreement.rent_amount) %><%= t('rental_agreements.monthly_suffix') %></span>
        <button type="button"
                class="icon-btn"
                title="<%= t('forms.buttons.edit') %>"
                aria-label="<%= t('forms.buttons.edit') %>"
                style="display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;"
                data-action="click->rental-agreements#editRent"
                data-rental-agreements-edit-url="<%= edit_property_rental_agreement_path(@property, @agreement, inline: "rent") %>"
                data-rental-agreements-frame-id="<%= dom_id(@agreement, :rent) %>">
          <%= heroicon "pencil", variant: :outline %>
        </button>
      </div>
    <% end %>
    <span class="badge badge-sm <%= @agreement.status_badge_class %>"><%= @agreement.status %></span>
  </div>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="payments">
  <div class="card-body">
    <h2 class="card-title text-base mb-4"><%= t("payments.payments") %></h2>

    <%= turbo_frame_tag dom_id(@agreement, :payments) do %>
      <% overdue = @payments.select(&:overdue?) %>
      <% if overdue.any? %>
        <div class="badge badge-error gap-1 mb-4">
          <%= t("payments.overdue_badge", count: overdue.size) %>
        </div>
      <% end %>

      <% if @payments.any? %>
        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th><%= t("payments.table_headers.due_date") %></th>
                <th><%= t("payments.table_headers.paid_date") %></th>
                <th><%= t("payments.table_headers.amount") %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @payments.each do |payment| %>
                <%= turbo_frame_tag dom_id(payment),
                      data: { row_url: property_rental_agreement_path(@property, @agreement) } do %>
                  <%= render "payments/payment", property: @property, agreement: @agreement, payment: payment %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50 mb-6">
          <p class="text-sm"><%= t("payments.no_payments") %></p>
        </div>
      <% end %>

      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-base"><%= t("payments.add_payments") %></h3>
          <%= render "payments/create_recurring_form", property: @property, agreement: @agreement %>
        </div>
      </div>
    <% end %>
  </div>
</div>
