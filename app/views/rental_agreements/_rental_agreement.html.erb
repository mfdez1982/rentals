<tr>
  <td>
    <%= link_to format_date(agreement.start_date),
        property_rental_agreement_path(property, agreement),
        class: "link link-primary",
        data: { turbo_frame: "_top" } %>
  </td>
  <td><%= format_date(agreement.end_date) %></td>
  <td><%= number_to_currency(agreement.rent_amount) %></td>
  <td>
    <div class="flex items-center gap-2">
      <span class="badge badge-sm <%= agreement_status_badge_class(agreement) %>">
        <%= agreement_status(agreement) %>
      </span>
      <% if agreement.has_overdue_payments? %>
        <span class="badge badge-sm badge-error">
          <%= t("properties.overdue_payments") %>
        </span>
      <% end %>
    </div>
  </td>
  <td class="text-right">
    <div class="inline-flex items-center gap-2">
      <%= button_to property_rental_agreement_path(property, agreement),
          method: :delete,
          class: "icon-btn",
          title: t("forms.buttons.delete"),
          form: { data: {
            turbo_confirm: t("rental_agreements.delete_confirm"),
            turbo_frame: dom_id(property, :agreements)
          } } do %>
        <%= heroicon "trash", variant: :outline %>
      <% end %>
      <%= link_to t("rental_agreements.renew"), new_property_rental_agreement_path(property, source_id: agreement.id),
          class: "btn btn-ghost btn-xs",
          data: { turbo_frame: dom_id(property, :agreements) } %>
    </div>
  </td>
</tr>
