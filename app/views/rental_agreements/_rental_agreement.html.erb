<tr>
  <td>
    <%= link_to agreement.start_date.strftime("%b %d, %Y"),
        property_rental_agreement_path(property, agreement),
        class: "link link-hover",
        data: { turbo_frame: "_top" } %>
  </td>
  <td><%= agreement.end_date.strftime("%b %d, %Y") %></td>
  <td><%= number_to_currency(agreement.rent_amount) %></td>
  <td>
    <span class="badge badge-sm <%= agreement.status_badge_class %>">
      <%= agreement.status %>
    </span>
  </td>
  <td class="text-right">
    <%= link_to "Edit", edit_property_rental_agreement_path(property, agreement),
        class: "btn btn-ghost btn-xs mr-1",
        data: { action: "click->rental-agreements#openEdit" } %>
    <%= button_to "Delete", property_rental_agreement_path(property, agreement),
        method: :delete,
        class: "btn btn-error btn-xs mr-1",
        form: { data: {
          turbo_confirm: "Delete this agreement? This cannot be undone.",
          turbo_frame: dom_id(property, :agreements)
        } } %>
    <%= link_to "Renew", new_property_rental_agreement_path(property, source_id: agreement.id),
        class: "btn btn-ghost btn-xs",
        data: { turbo_frame: dom_id(property, :agreements) } %>
  </td>
</tr>
