<tr>
  <td class="font-medium">
    <%= link_to property_path(property), class: "link link-primary", data: { turbo_frame: "_top" } do %>
      <%= property.name %>
    <% end %>
  </td>
  <td>
    <div class="flex items-center gap-2">
      <% if property.rented? %>
        <span class="badge badge-warning badge-sm"><%= t("properties.rented") %></span>
      <% else %>
        <span class="badge badge-success badge-sm"><%= t("properties.available") %></span>
      <% end %>
      <% if property.has_overdue_payments? %>
        <span class="badge badge-sm badge-error">
          <%= t("properties.overdue_payments") %>
        </span>
      <% end %>
    </div>
  </td>
  <td class="text-right">
    <div style="display:inline-flex; align-items:center; gap:8px;">
      <%= button_to property_path(property), method: :delete,
          class: "icon-btn",
          title: t("forms.buttons.delete"),
          style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;",
          form: { data: { turbo_confirm: t("properties.delete_confirm", name: property.name) } } do %>
        <%= heroicon "trash", variant: :outline %>
      <% end %>
    </div>
  </td>
</tr>
