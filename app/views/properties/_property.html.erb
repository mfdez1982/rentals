<tr>
  <td class="font-medium">
    <%= link_to property_path(property), class: "link link-hover", data: { turbo_frame: "_top" } do %>
      <%= property.name %>
    <% end %>
  </td>
  <td>
    <div class="flex items-center gap-2">
      <% if property.rented? %>
        <span class="badge badge-warning badge-sm">Rented</span>
      <% else %>
        <span class="badge badge-success badge-sm">Available</span>
      <% end %>
      <% if property.has_overdue_payments? %>
        <span class="badge badge-sm badge-error">
          Overdue Payments
        </span>
      <% end %>
    </div>
  </td>
  <td class="text-right">
    <div style="display:inline-flex; align-items:center; gap:8px;">
      <%= link_to edit_property_path(property),
          class: "icon-btn",
          title: "Edit",
          style: "display:inline-flex; color:inherit; cursor:pointer;",
          data: { action: "click->properties#openEdit" } do %>
        <%= heroicon "pencil", variant: :outline %>
      <% end %>
      <%= button_to property_path(property), method: :delete,
          class: "icon-btn",
          title: "Delete",
          style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;",
          form: { data: { turbo_confirm: "Delete \"#{property.name}\"? This cannot be undone." } } do %>
        <%= heroicon "trash", variant: :outline %>
      <% end %>
    </div>
  </td>
</tr>
