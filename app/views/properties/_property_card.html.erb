<div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow h-full"
     data-testid="property-card-<%= property.id %>">
  <!-- Header with Avatar and Delete -->
  <div class="card-body p-4 flex flex-col h-full">
    <div class="flex items-start justify-between mb-3">
      <%= link_to property_path(property), class: "flex items-center gap-3 flex-1 min-w-0 cursor-pointer", data: { turbo_frame: "_top" } do %>
        <% avatar = avatar_for_property(property) %>
        <div class="<%= avatar[:color_class] %> w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-white font-bold text-sm">
          <%= avatar[:initials] %>
        </div>
        <h3 class="card-title text-lg font-bold line-clamp-2"><%= property.name %></h3>
      <% end %>
      <div class="flex-shrink-0 ml-2">
        <%= button_to property_path(property), method: :delete,
            class: "btn btn-ghost btn-xs btn-circle",
            title: t("forms.buttons.delete"),
            form: { data: { turbo_confirm: t("properties.delete_confirm", name: property.name) } } do %>
          <%= heroicon "trash", variant: :outline %>
        <% end %>
      </div>
    </div>

    <!-- Status Badges -->
    <div class="flex flex-wrap gap-2 mb-3">
      <% if property.rented? %>
        <span class="badge badge-warning badge-sm"><%= t("properties.rented") %></span>
      <% else %>
        <span class="badge badge-success badge-sm"><%= t("properties.available") %></span>
      <% end %>
      <% if property.has_overdue_payments? %>
        <span class="badge badge-error badge-sm">
          <%= t("properties.overdue_payments") %>
        </span>
      <% end %>
    </div>

    <!-- Active Rental Info -->
    <% agreement = property.active_rental_agreement %>
    <% if agreement %>
      <%= link_to property_path(property), class: "space-y-2 text-sm mb-3 cursor-pointer hover:opacity-80", data: { turbo_frame: "_top" } do %>
        <div class="flex justify-between">
          <span class="text-base-content/60"><%= t("properties.monthly_rent") %></span>
          <span class="font-semibold"><%= number_to_currency(agreement.rent_amount) %></span>
        </div>

        <% payment = property.next_unpaid_payment %>
        <% if payment %>
          <div class="flex justify-between">
            <span class="text-base-content/60"><%= t("properties.next_payment_due") %></span>
            <% if payment.overdue? %>
              <span class="text-error font-semibold">
                <%= t("properties.days_overdue", count: (Date.today - payment.due_date).to_i) %>
              </span>
            <% else %>
              <span><%= l(payment.due_date, format: :short) %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
