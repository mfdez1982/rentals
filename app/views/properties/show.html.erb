<%# Hidden frame: keeps the inline-edit cancel/restore flow working in the properties index %>
<%= turbo_frame_tag dom_id(@property), style: "display: none" do %>
  <%= render "properties/property", property: @property %>
<% end %>

<div class="mb-6">
  <%= link_to "← My Properties", properties_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="flex items-center justify-between mb-6">
  <%= turbo_frame_tag dom_id(@property, :name) do %>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold"><%= @property.name %></h1>
      <%= link_to edit_property_path(@property, inline: true),
            data: { turbo_frame: dom_id(@property, :name) },
            class: "btn btn-ghost btn-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 9.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
      <% end %>
    </div>
  <% end %>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="rental-agreements">
  <div class="card-body">
    <h2 class="card-title text-base mb-4">Rental Agreements</h2>

    <%= turbo_frame_tag dom_id(@property, :agreements) do %>
      <% if @agreements.any? %>
        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Monthly Rent</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @agreements.each do |agreement| %>
                <%= turbo_frame_tag dom_id(agreement), data: { row_url: property_path(@property) } do %>
                  <%= render "rental_agreements/rental_agreement", property: @property, agreement: agreement %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50 mb-6">
          <p class="text-sm">No rental agreements yet. Add one below.</p>
        </div>
      <% end %>

      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-base">Add Rental Agreement</h3>
          <%= render "rental_agreements/form", property: @property, agreement: @new_agreement %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow-sm mt-6" data-controller="expenses">
  <div class="card-body">
    <h2 class="card-title text-base mb-4">Expenses</h2>

    <%= turbo_frame_tag dom_id(@property, :expenses) do %>
      <% if @expenses.any? %>
        <div class="overflow-x-auto mb-6">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @expenses.each do |expense| %>
                <%= turbo_frame_tag dom_id(expense), data: { row_url: property_path(@property) } do %>
                  <%= render "expenses/expense", property: @property, expense: expense %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50 mb-6">
          <p class="text-sm">No expenses recorded yet. Add one below.</p>
        </div>
      <% end %>

      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-base">Add Expense</h3>
          <%= render "expenses/form", property: @property, expense: @new_expense %>
        </div>
      </div>
    <% end %>
  </div>
</div>
