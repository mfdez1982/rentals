<%# Hidden frame: keeps the inline-edit cancel/restore flow working in the properties index %>
<%= turbo_frame_tag dom_id(@property), style: "display: none" do %>
  <%= render "properties/property", property: @property %>
<% end %>

<!-- Global Navigation & Header (Always Visible) -->
<div class="mb-6">
  <%= link_to t("common.my_properties_link"), properties_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="flex items-center justify-start mb-6">
  <%= turbo_frame_tag dom_id(@property, :name) do %>
    <div class="flex items-center gap-3"
         data-action="dblclick->properties#editName"
         data-properties-edit-url="<%= edit_property_path(@property, inline: true) %>"
         data-properties-frame-id="<%= dom_id(@property, :name) %>">
      <h1 class="text-2xl font-bold cursor-pointer hover:opacity-75 transition-opacity" title="<%= t('properties.edit_inline') %>"><%= @property.name %></h1>
      <button type="button"
              class="icon-btn"
              title="<%= t('forms.buttons.edit') %>"
              aria-label="<%= t('forms.buttons.edit') %>"
              style="display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;"
              data-action="click->properties#editName"
              data-properties-edit-url="<%= edit_property_path(@property, inline: true) %>"
              data-properties-frame-id="<%= dom_id(@property, :name) %>">
        <%= heroicon "pencil", variant: :outline %>
      </button>
    </div>
  <% end %>
</div>

<!-- Navigation Tabs & Content (Tab-Managed) -->
<div data-controller="properties" data-properties-active-tab-value="contratos">
  <nav class="flex gap-8 border-b border-base-300 mb-6">
    <%= link_to t("rental_agreements.new_rental_agreement"), "#",
        data: { properties_tab: "contratos", action: "click->properties#selectTab" } %>

    <%= link_to t("tax_report.deductible_expenses"), "#",
        data: { properties_tab: "gastos", action: "click->properties#selectTab" } %>

    <%= link_to t("notes.my_notes"), "#",
        data: { properties_tab: "notas", action: "click->properties#selectTab" } %>

    <%= link_to t("tax_report.title"), "#",
        data: { properties_tab: "tax_report", action: "click->properties#selectTab" } %>
  </nav>

  <!-- Rental Agreements Section -->
<div data-property-section="contratos">
    <div class="card bg-base-100 shadow-sm" data-controller="rental-agreements modal">
      <div class="card-body">
        <!-- Toolbar -->
        <div class="flex items-center justify-between mb-6">
          <h2 class="card-title text-base"><%= t("rental_agreements.new_rental_agreement") %></h2>
          <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
            <%= t("rental_agreements.new_rental_agreement") %>
          </button>
        </div>

    <%= turbo_frame_tag dom_id(@property, :agreements) do %>
      <% if @agreements.any? %>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th><%= t("rental_agreements.start_date") %></th>
                <th><%= t("rental_agreements.end_date") %></th>
                <th><%= t("rental_agreements.monthly_rent") %></th>
                <th><%= t("properties.status") %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @agreements.each do |agreement| %>
                <%= turbo_frame_tag dom_id(agreement), data: { row_url: property_path(@property) } do %>
                  <%= render "rental_agreements/rental_agreement", property: @property, agreement: agreement %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-base-content/50">
          <p class="text-sm"><%= t("rental_agreements.no_agreements") %></p>
        </div>
      <% end %>
    <% end %>

    <!-- Rental Agreement Modal -->
    <dialog class="modal" data-modal-target="dialog">
      <div class="modal-box max-w-lg">
        <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>
        <h3 class="font-bold text-lg mb-4"><%= t("rental_agreements.new_rental_agreement") %></h3>
        <%= render "rental_agreements/form", property: @property, agreement: @new_agreement %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button></button>
      </form>
    </dialog>
      </div>
    </div>
  </div>

  <!-- Expenses Section -->
  <div data-property-section="gastos">
    <div class="card bg-base-100 shadow-sm" data-controller="modal">
  <div class="card-body">
    <!-- Toolbar -->
    <div class="flex items-center justify-between mb-6">
      <h2 class="card-title text-base"><%= t("tax_report.deductible_expenses") %></h2>
      <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
        <%= t("tax_report.deductible_expenses") %>
      </button>
    </div>

    <div data-controller="modal">
      <%= turbo_frame_tag dom_id(@property, :expenses) do %>
        <% if @expenses.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th><%= t("expenses.date") %></th>
                  <th><%= t("expenses.category") %></th>
                  <th><%= t("expenses.description") %></th>
                  <th><%= t("expenses.amount") %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @expenses.each do |expense| %>
                  <%= render "expenses/expense", property: @property, expense: expense %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8 text-base-content/50">
            <p class="text-sm"><%= t("expenses.no_expenses", year: Date.today.year) %></p>
          </div>
        <% end %>
      <% end %>

      <!-- Expense Edit Modal -->
      <dialog class="modal" data-modal-target="dialog">
        <div class="modal-box max-w-lg">
          <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>
          <%= turbo_frame_tag "expense_edit_frame" %>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button></button>
        </form>
      </dialog>
    </div>

    <!-- Expense Modal -->
    <dialog class="modal" data-modal-target="dialog">
      <div class="modal-box max-w-lg">
        <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>
        <h3 class="font-bold text-lg mb-4"><%= t("tax_report.deductible_expenses") %></h3>
        <%= render "expenses/form", property: @property, expense: @new_expense %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button></button>
      </form>
    </dialog>
    </div>
  </div>
  </div>

  <!-- Notes Section -->
  <div data-property-section="notas">
    <div class="card bg-base-100 shadow-sm" data-controller="notes modal">
  <div class="card-body">
    <!-- Toolbar -->
    <div class="flex items-center justify-between mb-6">
      <h2 class="card-title text-base"><%= t("notes.my_notes") %></h2>
      <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
        <%= t("notes.add_note") %>
      </button>
    </div>

    <% all_property_notes = @property_notes + @agreement_notes %>
    <div class="overflow-x-auto">
      <% if all_property_notes.any? %>
        <%= render "notes/notes_list", notes: all_property_notes %>
      <% else %>
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th><%= t("notes.title") %></th>
              <th><%= t("notes.related_to", default: "Related to") %></th>
              <th><%= t("notes.due_date") %></th>
              <th><%= t("general.actions", default: "Actions") %></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      <% end %>
    </div>

    <!-- Notes Modal -->
    <dialog class="modal" data-modal-target="dialog">
      <div class="modal-box max-w-lg">
        <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>
        <h3 class="font-bold text-lg mb-4"><%= t("notes.add_note") %></h3>

        <%= form_with(model: Note.new(landlord: current_landlord), local: true) do |form| %>
          <%= form.hidden_field :noteable_type, value: "Property" %>
          <%= form.hidden_field :noteable_id, value: @property.id %>

          <div class="space-y-4 mb-6">
            <div class="form-control">
              <%= form.label :title %>
              <%= form.text_field :title, placeholder: t("notes.title"), class: "input input-bordered w-full input-sm" %>
            </div>
            <div class="form-control">
              <%= form.label :description %>
              <%= form.text_field :description, placeholder: t("notes.description"), class: "input input-bordered w-full input-sm" %>
            </div>
            <div class="form-control">
              <%= form.label :due_date, t("notes.due_date") %>
              <%= form.date_field :due_date, class: "input input-bordered w-full input-sm" %>
            </div>
          </div>

          <div class="flex gap-3 justify-end">
            <button type="button" class="btn btn-ghost btn-sm" data-action="modal#close">
              <%= t("forms.buttons.cancel") %>
            </button>
            <%= form.submit t("notes.add_note"), class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button></button>
      </form>
    </dialog>
    </div>
  </div>
  </div>

  <!-- Tax Report Section -->
  <div data-property-section="tax_report">
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <!-- Header -->
        <h2 class="card-title text-base mb-6"><%= t("tax_report.title") %></h2>

        <%= render "tax_report_content", property: @property %>
      </div>
    </div>
  </div>
</div>
