<%= render "shared/dashboard_layout" do %>
  <% at_property_limit = current_landlord.property_limit_reached? %>
  <div data-controller="modal">
    <div class="flex items-center justify-between mb-6">
      <div>
        <button type="button" class="btn btn-primary btn-sm" data-action="modal#open" <%= "disabled" if at_property_limit %>>
          <%= t("properties.add_property") %>
        </button>
        <% if at_property_limit %>
          <p class="text-sm text-base-content/60 mt-1"><%= t("properties.plan_limit_hint") %></p>
        <% end %>
      </div>
    </div>

    <% if @properties.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-testid="properties-grid">
        <% @properties.each do |property| %>
          <%= turbo_frame_tag dom_id(property) do %>
            <%= render "property_card", property: property %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center justify-center min-h-96">
        <div class="text-center">
          <p class="text-lg text-base-content/60 mb-4"><%= t("properties.no_properties") %></p>
          <p class="text-sm text-base-content/40 mb-6"><%= t("properties.no_properties_hint") %></p>
          <button type="button" class="btn btn-primary" data-action="modal#open">
            <%= t("properties.add_property") %>
          </button>
        </div>
      </div>
    <% end %>

    <!-- Add Property Modal -->
    <%= render layout: "shared/modal", locals: { title: t("properties.add_property"), box_class: "max-w-lg" } do %>
      <%= render "form", property: @new_property %>
    <% end %>
  </div>
<% end %>
