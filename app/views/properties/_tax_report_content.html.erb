<%= turbo_frame_tag dom_id(property, :tax_report) do %>
<!-- Year Selector + Calculate -->
<div class="mb-8 flex items-baseline gap-3" data-controller="year-select" data-year-select-base-url-value="<%= tax_report_property_path(property) %>">
  <label for="tax_report_year" class="text-sm font-semibold text-base-content/70"><%= t("tax_report.select_year") %></label>
  <select id="tax_report_year" class="select select-bordered select-sm w-32" data-year-select-target="year">
    <% @year_options.each do |year| %>
      <option value="<%= year %>" <%= "selected" if year == @year %>><%= year %></option>
    <% end %>
  </select>
  <button type="button" class="btn btn-primary btn-sm" data-action="click->year-select#calculate">
    <%= t("tax_report.calculate") %>
  </button>
</div>

<% unless @calculated %>
  <div class="text-center py-8 text-base-content/50">
    <p class="text-sm"><%= t("tax_report.resting_hint") %></p>
  </div>
<% else %>
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <!-- Active Days Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.active_rental_days") %></div>
        <div class="text-3xl font-bold"><%= @report[:active_rental_days] %></div>
        <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.active_rental_days_hint", total: @report[:total_days], year: @year) %></div>
      </div>
    </div>

    <!-- Pro-rata Ratio Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.pro_rata_ratio") %></div>
        <div class="text-3xl font-bold"><%= number_to_percentage(@report[:pro_rata_ratio] * 100, precision: 2) %></div>
        <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.pro_rata_ratio_hint") %></div>
      </div>
    </div>

    <!-- Total Gross Income Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="text-sm font-semibold text-base-content/70"><%= t("tax_report.total_gross_income") %></div>
        <div class="text-3xl font-bold"><%= number_to_currency(@report[:total_gross_income]) %></div>
        <div class="text-xs text-base-content/50 mt-1"><%= t("tax_report.total_gross_income_hint", year: @year) %></div>
      </div>
    </div>
  </div>

  <% if @collectable_deductible_expenses.present? %>
    <div class="mb-6">
      <div class="alert alert-warning mb-4" role="status">
        <span class="text-sm"><%= t("tax_report.validate_expenses_warning") %></span>
      </div>
      <div class="overflow-x-auto mb-2">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th><%= t("tax_report.table_headers.date") %></th>
              <th><%= t("tax_report.table_headers.category") %></th>
              <th><%= t("tax_report.table_headers.description") %></th>
              <th class="text-right"><%= t("tax_report.table_headers.original_amount") %></th>
            </tr>
          </thead>
          <tbody>
            <% @collectable_deductible_expenses.each do |expense| %>
              <tr>
                <td><%= l(expense.date, format: :short) %></td>
                <td>
                  <span class="badge badge-sm">
                    <%= t("expenses.categories.#{expense.category}") %>
                  </span>
                </td>
                <td><%= expense.description || "—" %></td>
                <td class="text-right"><%= number_to_currency(expense.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-base-content/50"><%= t("tax_report.validate_expenses_hint") %></p>
    </div>
  <% end %>

  <!-- Expenses Table -->
  <h3 class="font-semibold text-base-content/70 mb-2"><%= t("tax_report.deductible_expenses") %></h3>

  <% if @report[:expenses].any? %>
    <div class="overflow-x-auto">
      <table class="table table-zebra table-sm">
        <thead>
          <tr>
            <th><%= t("tax_report.table_headers.date") %></th>
            <th><%= t("tax_report.table_headers.category") %></th>
            <th><%= t("tax_report.table_headers.description") %></th>
            <th class="text-right"><%= t("tax_report.table_headers.original_amount") %></th>
            <th class="text-right"><%= t("tax_report.table_headers.deductible_amount") %></th>
          </tr>
        </thead>
        <tbody>
          <% @report[:expenses].each do |expense| %>
            <tr>
              <td><%= l(expense[:date], format: :short) %></td>
              <td>
                <span class="badge badge-sm">
                  <%= t("expenses.categories.#{expense[:category]}") %>
                </span>
              </td>
              <td><%= expense[:description] || "—" %></td>
              <td class="text-right"><%= number_to_currency(expense[:original_amount]) %></td>
              <td class="text-right font-semibold text-success">
                <%= number_to_currency(expense[:deductible_amount]) %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="font-semibold bg-base-200">
            <td colspan="3"><%= t("tax_report.total_row") %></td>
            <td class="text-right">
              <%= number_to_currency(@report[:expenses].sum { |e| e[:original_amount] }) %>
            </td>
            <td class="text-right text-success">
              <%= number_to_currency(@report[:expenses].sum { |e| e[:deductible_amount] }) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-base-content/50">
      <p class="text-sm"><%= t("tax_report.no_expenses", year: @year) %></p>
    </div>
  <% end %>

  <div class="mt-6">
    <div class="alert bg-base-200 border-base-300 text-base-content/70">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="shrink-0 w-6 h-6 stroke-base-content/50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span class="text-sm">
        <%= t("tax_report.pro_rata_explanation", ratio: number_to_percentage(@report[:pro_rata_ratio] * 100, precision: 2)) %>
      </span>
    </div>
  </div>
<% end %>
<% end %>
