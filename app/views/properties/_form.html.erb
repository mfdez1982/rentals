<%= form_with model: property, data: local_assigns.fetch(:form_data, { turbo_frame: "_top" }) do |f| %>
  <div class="space-y-4 max-w-md">
    <% if local_assigns[:inline] %>
      <input type="hidden" name="inline" value="true">
    <% end %>

    <% if property.errors.any? %>
      <div role="alert" class="alert alert-error">
        <ul class="list-disc list-inside text-sm">
          <% property.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, t("properties.form.name_label"), class: "label mb-1" %>
      <%= f.text_field :name, class: "input input-bordered w-full",
            placeholder: t("properties.form.name_placeholder") %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit t("forms.buttons.submit"), class: "btn btn-primary" %>
      <button type="button" class="btn btn-ghost" data-action="modal#close"><%= t("forms.buttons.cancel") %></button>
    </div>
  </div>
<% end %>
