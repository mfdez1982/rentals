<div class="min-h-screen bg-base-100 flex items-center justify-center py-12 px-4">
  <div class="card bg-base-100 border border-base-300 shadow-lg max-w-lg w-full">
    <div class="card-body">
      <%= turbo_frame_tag "payment_edit_frame" do %>
        <h3 class="font-bold text-lg mb-4"><%= t("payments.edit_payment") %></h3>
        <%= render "form", property: @property, agreement: @agreement, payment: @payment %>
      <% end %>
    </div>
  </div>
</div>
