<tr>
  <td><%= format_date(payment.due_date) %></td>
  <td>
    <% if payment.paid_date %>
      <%= format_date(payment.paid_date) %>
    <% elsif payment.overdue? %>
      <span class="text-error font-medium"><%= t("payments.overdue") %></span>
    <% else %>
      <span class="text-base-content/50"><%= t("payments.unpaid") %></span>
    <% end %>
  </td>
  <td><%= number_to_currency(payment.amount) %></td>
  <td class="text-right">
    <div class="inline-flex items-center gap-2">
      <%= render "shared/edit_icon_button", path: edit_property_rental_agreement_payment_path(property, agreement, payment), frame: "payment_edit_frame" %>
      <%= render "shared/delete_icon_button", path: property_rental_agreement_payment_path(property, agreement, payment), confirm: t("payments.delete_confirm"), frame: dom_id(agreement, :payments) %>
    </div>
  </td>
</tr>
