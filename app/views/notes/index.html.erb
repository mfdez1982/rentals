<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold"><%= t("notes.my_notes") %></h1>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="modal">
  <div class="card-body">
    <!-- Toolbar -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-4">
        <h2 class="card-title text-base"><%= t("notes.filters.label", default: "Filters") %></h2>
        <%= form_with url: notes_path, method: :get, local: true, class: "flex-1" do |form| %>
          <select name="filter" class="select select-bordered select-sm max-w-xs" onchange="this.form.submit()">
            <option value="all" <%= "selected" if @filter == "all" %>><%= t("notes.filters.all") %></option>
            <option value="active" <%= "selected" if @filter == "active" %>><%= t("notes.filters.active") %></option>
            <option value="completed" <%= "selected" if @filter == "completed" %>><%= t("notes.filters.completed") %></option>
            <option value="overdue" <%= "selected" if @filter == "overdue" %>><%= t("notes.filters.overdue") %></option>
          </select>
        <% end %>
      </div>
      <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
        <%= t("notes.add_note") %>
      </button>
    </div>

    <!-- Notes list -->
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th><%= t("notes.title") %></th>
            <th><%= t("notes.related_to", default: "Related to") %></th>
            <th><%= t("notes.due_date") %></th>
            <th><%= t("general.actions", default: "Actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @notes.each do |note| %>
            <tr class="<%= note.completed? ? 'opacity-50' : '' %> <%= note.overdue? ? 'bg-error/10' : '' %>">
              <td>
                <div class="flex items-center gap-3">
                  <% if note.completed? %>
                    <span class="line-through text-base-400"><%= note.title %></span>
                  <% else %>
                    <span><%= note.title %></span>
                  <% end %>
                  <% if note.completed? %>
                    <span class="badge badge-ghost"><%= t("notes.status.completed") %></span>
                  <% end %>
                </div>
              </td>
              <td><%= related_to_label(note) %></td>
              <td>
                <% if note.due_date %>
                  <div class="flex items-center gap-2">
                    <span><%= l(note.due_date, format: :short) %></span>
                    <% if note.overdue? %>
                      <span class="badge badge-error"><%= t("notes.overdue") %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-base-400">—</span>
                <% end %>
              </td>
              <td>
                <div style="display:inline-flex; align-items:center; gap:8px;">
                  <% if note.active? && note.activity? %>
                    <%= button_to mark_complete_note_path(note), method: :patch,
                        class: "icon-btn",
                        title: t("notes.mark_complete"),
                        style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;" do %>
                      <%= heroicon "check", variant: :outline %>
                    <% end %>
                  <% end %>
                  <%= link_to edit_note_path(note),
                      class: "icon-btn",
                      title: t("notes.edit"),
                      style: "display:inline-flex; color:inherit; cursor:pointer;" do %>
                    <%= heroicon "pencil", variant: :outline %>
                  <% end %>
                  <%= button_to note_path(note), method: :delete, data: { confirm: t("notes.confirm_delete", default: "Are you sure?") },
                      class: "icon-btn",
                      title: t("notes.delete"),
                      style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;" do %>
                    <%= heroicon "trash", variant: :outline %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Add Note Modal -->
    <dialog class="modal" data-modal-target="dialog">
      <div class="modal-box">
        <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>

        <h3 class="font-bold text-lg mb-4"><%= t("notes.add_note") %></h3>

        <%= form_with(model: @new_note || Note.new, local: true) do |form| %>
          <% if form.object.errors.any? %>
            <div class="alert alert-error mb-4">
              <div>
                <h4 class="font-bold"><%= t("general.form_errors", count: form.object.errors.count) %></h4>
                <ul class="list-disc list-inside text-sm mt-2">
                  <% form.object.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <div class="space-y-4 mb-6">
            <div class="form-control">
              <%= form.label :title %>
              <%= form.text_field :title, placeholder: t("notes.title"), class: "input input-bordered w-full" %>
            </div>

            <div class="form-control">
              <%= form.label :description %>
              <%= form.text_field :description, placeholder: t("notes.description"), class: "input input-bordered w-full" %>
            </div>

            <div class="form-control">
              <%= form.label :due_date, t("notes.due_date") %>
              <%= form.date_field :due_date, class: "input input-bordered w-full" %>
            </div>
          </div>

          <div class="flex gap-3 justify-end">
            <button type="button" class="btn btn-ghost" data-action="modal#close">
              <%= t("forms.buttons.cancel") %>
            </button>
            <%= form.submit t("notes.add_note"), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button></button>
      </form>
    </dialog>
  </div>
</div>
