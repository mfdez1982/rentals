<div class="min-h-screen bg-base-100">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8"><%= t("notes.my_notes") %></h1>

    <div class="flex gap-8">
      <!-- Sidebar: Filters -->
      <div class="w-48 flex-shrink-0">
        <div class="card bg-base-200 p-6">
          <h2 class="font-bold mb-4"><%= t("notes.filters.label", default: "Filters") %></h2>
          <div class="space-y-2">
            <%= link_to t("notes.filters.all"), notes_path(filter: nil), class: "btn btn-block btn-sm #{@filter.nil? || @filter == 'active' ? 'btn-primary' : 'btn-ghost'}" %>
            <%= link_to t("notes.filters.active"), notes_path(filter: "active"), class: "btn btn-block btn-sm #{@filter == 'active' ? 'btn-primary' : 'btn-ghost'}" %>
            <%= link_to t("notes.filters.completed"), notes_path(filter: "completed"), class: "btn btn-block btn-sm #{@filter == 'completed' ? 'btn-primary' : 'btn-ghost'}" %>
            <%= link_to t("notes.filters.overdue"), notes_path(filter: "overdue"), class: "btn btn-block btn-sm #{@filter == 'overdue' ? 'btn-primary' : 'btn-ghost'}" %>
          </div>
        </div>
      </div>

      <!-- Main content: Notes list + Create form -->
      <div class="flex-1">
        <!-- Create Note Form -->
        <div class="card bg-base-100 border border-base-300 shadow-lg mb-8">
          <div class="card-body">
            <h2 class="card-title text-lg font-bold mb-4"><%= t("notes.add_note") %></h2>

            <%= form_with(model: @new_note || Note.new, local: true) do |form| %>
              <% if form.object.errors.any? %>
                <div class="alert alert-error mb-4">
                  <div>
                    <h4 class="font-bold"><%= t("general.form_errors", count: form.object.errors.count) %></h4>
                    <ul class="list-disc list-inside text-sm mt-2">
                      <% form.object.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div class="form-control md:col-span-1">
                  <%= form.label :title %>
                  <%= form.text_field :title, placeholder: t("notes.title"), class: "input input-bordered w-full" %>
                </div>

                <div class="form-control md:col-span-1">
                  <%= form.label :description %>
                  <%= form.text_field :description, placeholder: t("notes.description"), class: "input input-bordered w-full" %>
                </div>

                <div class="form-control md:col-span-1">
                  <%= form.label :due_date, t("notes.due_date") %>
                  <%= form.date_field :due_date, class: "input input-bordered w-full" %>
                </div>
              </div>

              <div class="flex gap-3">
                <%= form.submit t("notes.add_note"), class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Notes List -->
        <% if @notes.any? %>
          <%= render "notes_list", notes: @notes %>
        <% else %>
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span><%= t("notes.no_notes", default: "No notes yet") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
