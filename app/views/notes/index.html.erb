<%= render "shared/dashboard_layout" do %>
  <div>

  <div class="card bg-base-100 shadow-sm" data-controller="modal">
  <div class="card-body">
    <!-- Toolbar -->
    <div class="flex items-center justify-end mb-6">
      <button type="button" class="btn btn-primary btn-sm" data-action="modal#open">
        <%= t("notes.add_note") %>
      </button>
    </div>

    <!-- Notes list -->
    <%= render "notes_list", notes: @notes %>

    <!-- Add Note Modal -->
    <dialog class="modal" data-modal-target="dialog">
      <div class="modal-box">
        <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="modal#close">✕</button>

        <h3 class="font-bold text-lg mb-4"><%= t("notes.add_note") %></h3>

        <%= form_with(model: @new_note || Note.new, local: true) do |form| %>
          <% if form.object.errors.any? %>
            <div class="alert alert-error mb-4">
              <div>
                <h4 class="font-bold"><%= t("general.form_errors", count: form.object.errors.count) %></h4>
                <ul class="list-disc list-inside text-sm mt-2">
                  <% form.object.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <div class="space-y-4 mb-6">
            <div class="form-control">
              <%= form.label :title %>
              <%= form.text_field :title, placeholder: t("notes.title"), class: "input input-bordered w-full" %>
            </div>

            <div class="form-control">
              <%= form.label :description %>
              <%= form.text_field :description, placeholder: t("notes.description"), class: "input input-bordered w-full" %>
            </div>

            <div class="form-control">
              <%= form.label :due_date, t("notes.due_date") %>
              <%= form.date_field :due_date, class: "input input-bordered w-full" %>
            </div>
          </div>

          <div class="flex gap-2 pt-2">
            <%= form.submit t("forms.buttons.submit"), class: "btn btn-primary" %>
            <button type="button" class="btn btn-ghost" data-action="modal#close"><%= t("forms.buttons.cancel") %></button>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button></button>
      </form>
    </dialog>
  </div>
  </div>
<% end %>
