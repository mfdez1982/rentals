<% noteable = local_assigns[:noteable] %>
<% frame = local_assigns[:frame] %>
<% return_frame = local_assigns[:return_frame] %>
<% expanded = local_assigns.fetch(:expanded, false) %>
<% input_class = "input input-bordered w-full#{' input-sm' if noteable.present?}" %>
<% form_data = if return_frame || expanded
     { turbo_frame: return_frame.presence || "_top" }
   elsif frame.present?
     { turbo_frame: frame }
   else
     {}
   end %>

<%= form_with(model: note, local: (noteable.nil? && !expanded), data: form_data) do |form| %>
  <% if expanded && return_frame.present? %>
    <%= hidden_field_tag :frame, return_frame %>
  <% end %>

  <% if noteable.present? %>
    <%= form.hidden_field :noteable_type, value: noteable.class.name %>
    <%= form.hidden_field :noteable_id, value: noteable.id %>
  <% end %>

  <%= render "shared/form_errors", model: note %>

  <div class="space-y-4 mb-6">
    <div class="form-control">
      <%= form.label :title %>
      <%= form.text_field :title, placeholder: t("notes.title"), class: input_class, required: true %>
    </div>
    <div class="form-control">
      <%= form.label :description %>
      <% if expanded %>
        <%= form.text_area :description, rows: 4, placeholder: t("notes.description"), class: "textarea textarea-bordered w-full", required: true %>
      <% else %>
        <%= form.text_field :description, placeholder: t("notes.description"), class: input_class, required: true %>
      <% end %>
    </div>
    <div class="form-control">
      <%= form.label :due_date, t("notes.due_date") %>
      <%= form.date_field :due_date, class: input_class %>
      <% if expanded %>
        <label class="label">
          <span class="label-text-alt"><%= t("notes.due_date_hint") %></span>
        </label>
      <% end %>
    </div>
  </div>

  <%= render "shared/form_actions", form: form %>
<% end %>
