<% noteable = local_assigns[:noteable] %>
<% frame = local_assigns[:frame] %>
<% input_class = "input input-bordered w-full#{' input-sm' if noteable.present?}" %>

<%= form_with(model: note, local: noteable.nil?, data: (frame.present? ? { turbo_frame: frame } : {})) do |form| %>
  <% if noteable.present? %>
    <%= form.hidden_field :noteable_type, value: noteable.class.name %>
    <%= form.hidden_field :noteable_id, value: noteable.id %>
  <% end %>

  <% if form.object.errors.any? %>
    <div class="alert alert-error mb-4">
      <div>
        <h4 class="font-bold"><%= t("general.form_errors", count: form.object.errors.count) %></h4>
        <ul class="list-disc list-inside text-sm mt-2">
          <% form.object.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="space-y-4 mb-6">
    <div class="form-control">
      <%= form.label :title %>
      <%= form.text_field :title, placeholder: t("notes.title"), class: input_class, required: true %>
    </div>
    <div class="form-control">
      <%= form.label :description %>
      <%= form.text_field :description, placeholder: t("notes.description"), class: input_class, required: true %>
    </div>
    <div class="form-control">
      <%= form.label :due_date, t("notes.due_date") %>
      <%= form.date_field :due_date, class: input_class %>
    </div>
  </div>

  <div class="flex gap-2 pt-2">
    <%= form.submit t("forms.buttons.submit"), class: "btn btn-primary" %>
    <button type="button" class="btn btn-ghost" data-action="modal#close"><%= t("forms.buttons.cancel") %></button>
  </div>
<% end %>
