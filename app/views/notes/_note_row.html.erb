<div class="card card-bordered <%= note.overdue? ? 'border-error' : '' %>">
  <div class="card-body p-4">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <h3 class="card-title text-lg font-semibold">
          <% if note.completed? %>
            <span class="line-through text-base-400"><%= note.title %></span>
          <% else %>
            <%= note.title %>
          <% end %>
        </h3>
        <p class="text-base-600 mt-2"><%= note.description %></p>

        <div class="flex gap-3 mt-4">
          <% if note.activity? %>
            <div class="badge <%= note.overdue? ? 'badge-error' : (note.completed? ? 'badge-ghost' : 'badge-warning') %>">
              <% if note.completed? %>
                <%= t("notes.completed_on", date: l(note.completed_at, format: :short)) %>
              <% elsif note.overdue? %>
                <%= t("notes.overdue") %>
              <% else %>
                <%= t("notes.due", date: l(note.due_date, format: :short)) %>
              <% end %>
            </div>
          <% end %>

          <% if note.completed? %>
            <span class="badge badge-ghost"><%= t("notes.status.completed") %></span>
          <% end %>
        </div>
      </div>

      <div class="flex gap-2 flex-shrink-0" style="display:inline-flex; align-items:center;">
        <% if note.active? && note.activity? %>
          <%= button_to mark_complete_note_path(note), method: :patch,
              class: "icon-btn",
              title: t("notes.mark_complete"),
              style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;" do %>
            <%= heroicon "check", variant: :outline %>
          <% end %>
        <% end %>
        <%= link_to edit_note_path(note),
            class: "icon-btn",
            title: t("notes.edit"),
            style: "display:inline-flex; color:inherit; cursor:pointer;" do %>
          <%= heroicon "pencil", variant: :outline %>
        <% end %>
        <%= button_to note_path(note), method: :delete, data: { confirm: t("notes.confirm_delete", default: "Are you sure?") },
            class: "icon-btn",
            title: t("notes.delete"),
            style: "display:inline-flex; color:inherit; cursor:pointer; background:none; border:none; padding:0;" do %>
          <%= heroicon "trash", variant: :outline %>
        <% end %>
      </div>
    </div>
  </div>
</div>
