<% note_frame_id = local_assigns[:note_frame_id] %>
<div data-controller="modal">
<div class="overflow-x-auto">
  <% if notes.any? %>
  <table class="table table-zebra w-full">
    <thead>
      <tr>
        <th><%= t("notes.title") %></th>
        <th><%= t("notes.related_to") %></th>
        <th><%= t("notes.due_date") %></th>
        <th><%= t("general.actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% notes.each do |note| %>
        <tr class="<%= note.completed? ? 'opacity-50' : '' %> <%= note.overdue? ? 'bg-error/10' : '' %>">
          <td>
            <div class="flex items-center gap-3">
              <% if note.completed? %>
                <span class="line-through text-base-400"><%= note.title %></span>
              <% else %>
                <span><%= note.title %></span>
              <% end %>
              <% if note.completed? %>
                <span class="badge badge-ghost"><%= t("notes.status.completed") %></span>
              <% end %>
            </div>
          </td>
          <td><%= related_to_label(note) %></td>
          <td>
            <% if note.due_date %>
              <div class="flex items-center gap-2">
                <span><%= l(note.due_date, format: :short) %></span>
                <% if note.overdue? %>
                  <span class="badge badge-error"><%= t("notes.overdue") %></span>
                <% end %>
              </div>
            <% else %>
              <span class="text-base-400">—</span>
            <% end %>
          </td>
          <td>
            <div class="inline-flex items-center gap-2">
              <% if note.active? && note.activity? %>
                <%= button_to mark_complete_note_path(note), method: :patch,
                    class: "icon-btn",
                    title: t("notes.mark_complete"),
                    form: (note_frame_id ? { data: { turbo_frame: note_frame_id } } : {}) do %>
                  <%= heroicon "check", variant: :outline %>
                <% end %>
              <% end %>
              <%= link_to edit_note_path(note, frame: note_frame_id),
                  class: "icon-btn",
                  title: t("notes.edit"),
                  data: { turbo_frame: "note_edit_frame", action: "click->modal#openFrame" } do %>
                <%= heroicon "pencil", variant: :outline %>
              <% end %>
              <%= button_to note_path(note), method: :delete, data: { confirm: t("notes.confirm_delete") },
                  class: "icon-btn",
                  title: t("notes.delete"),
                  form: (note_frame_id ? { data: { turbo_frame: note_frame_id } } : {}) do %>
                <%= heroicon "trash", variant: :outline %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% else %>
  <div class="text-center py-8 text-base-content/50">
    <p class="text-sm"><%= t("notes.no_notes") %></p>
  </div>
  <% end %>
</div>

<%= render layout: "shared/modal" do %>
  <%= turbo_frame_tag "note_edit_frame" %>
<% end %>
</div>
